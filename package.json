{
  "name": "visionary-bot",
  "version": "1.0.0",
  "type": "module",
  "dependencies": {
    "@vercel/kv": "^3.0.0",
    "telegraf": "^4.16.3"
  },
  "devDependencies": {
    "@vercel/node": "^3.2.0"
  },
  "vercel": {
    "rewrites": [
      { "source": "/((?!api/).*)", "destination": "/api/render" }
    ],
    "functions": {
      "api/[...path].ts": { "maxDuration": 60 }
    }
  }
}
